# APP_URL: Production or local domain
APP_URL="https://www.sizesnap.in"

# Google Analytics Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Google Search Console Verification Tag Content
NEXT_PUBLIC_GSC_VERIFICATION="your-verification-code-here"


# Cloudinary Integration (Free direct image upload for Blog)
# 1. Cloud Name (from Cloudinary Dashboard)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
# 2. Upload Preset (from Cloudinary Settings > Upload > Add Unsigned Preset)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="sizesnap_blog"
